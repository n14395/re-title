    "Select files to rename, or select a folder to rename files within it" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد الملفات لإعادة تسميتها، أو حدد مجلدًا لإعادة تسمية الملفات بداخله"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Dateien zum Umbenennen oder einen Ordner, um die darin enthaltenen Dateien umzubenennen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
