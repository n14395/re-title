    "macOS protects your files by requiring apps to request permission before accessing folders." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحمي macOS ملفاتك من خلال مطالبة التطبيقات بطلب الإذن قبل الوصول إلى المجلدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS schützt Ihre Dateien, indem Apps vor dem Zugriff auf Ordner um Erlaubnis bitten müssen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protege tus archivos al requerir que las aplicaciones soliciten permiso antes de acceder a las carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protège vos fichiers en exigeant que les applications demandent la permission avant d'accéder aux dossiers."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS מגן על הקבצים שלך על ידי דרישה מאפליקציות לבקש הרשאה לפני גישה לתיקיות."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS melindungi file Anda dengan mengharuskan aplikasi meminta izin sebelum mengakses folder."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS protegge i tuoi file richiedendo alle app di chiedere il permesso prima di accedere alle cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSはフォルダにアクセスする前にアプリに許可を求めることで、ファイルを保護しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS는 앱이 폴더에 접근하기 전에 권한을 요청하도록 하여 파일을 보호합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS beschermt uw bestanden door apps te verplichten toestemming te vragen voordat ze toegang krijgen tot mappen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chroni Twoje pliki, wymagając od aplikacji uzyskania zgody przed dostępem do folderów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS protege seus arquivos exigindo que os apps solicitem permissão antes de acessar pastas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS защищает ваши файлы, требуя от приложений запрашивать разрешение перед доступом к папкам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS skyddar dina filer genom att kräva att appar begär tillstånd innan de får åtkomst till mappar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ปกป้องไฟล์ของคุณโดยกำหนดให้แอปต้องขออนุญาตก่อนเข้าถึงโฟลเดอร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS, uygulamaların klasörlere erişmeden önce izin istemesini zorunlu kılarak dosyalarınızı korur."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS bảo vệ tệp của bạn bằng cách yêu cầu ứng dụng xin phép trước khi truy cập thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 通过要求应用在访问文件夹前请求权限来保护您的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 透過要求應用程式在存取資料夾前請求權限來保護您的檔案。"
          }
        }
      }
    },
