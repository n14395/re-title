      "isCommentAutoGenerated" : true
    },
    "%@ %@" : {
      "comment" : "A button with a checkmark next to it, used to indicate that a particular action type is currently selected. The text following the checkmark is the name of the action type. The argument is the “checkmark” symbol.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%lld file%@ renamed successfully." : {
      "comment" : "A message showing the number of files that were renamed successfully.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld file%2$@ renamed successfully."
          }
        }
      }
    },
    "%lld file%@ renamed successfully.\n%lld file%@ failed.\n\nErrors:\n%@" : {
      "comment" : "A message showing the number of files that were renamed successfully, the number of files that failed, and a list of any errors that occurred. The first argument is the count of successfully renamed files. The second argument is the count of files that failed to be renamed. The third argument is a block that returns a multi-line string containing the error messages for the files that failed to be renamed.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld file%2$@ renamed successfully.\n%3$lld file%4$@ failed.\n\nErrors:\n%5$@"
          }
        }
      }
    },
